GROQ_API_KEY=your_api_key_here
DATABASE_URL=sqlite:///./audit_annotate.db
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# URL of your Trial Balance tool — shown in the tool switcher nav.
# Example: https://yoursite.com/trial-balance
VITE_TRIAL_BALANCE_URL=https://trial-balance-toolv2.onrender.com

# Shared secret between Express host app and this FastAPI service.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank for standalone dev mode (no auth required).
AUDIT_SECRET=
